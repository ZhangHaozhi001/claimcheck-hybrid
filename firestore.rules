rules_version = '2';
// ClaimCheck Hybrid — demo rules: checks are public-readable during the
// hackathon judging window so judges can verify the archive works.
// TODO-HOOKUP (production): scope reads/writes per authenticated user,
// e.g. match /checks/{id} { allow read, write: if request.auth != null &&
// request.auth.uid == resource.data.ownerUid; } and add ownerUid on save.
service cloud.firestore {
  match /databases/{database}/documents {
    match /checks/{checkId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['claim', 'verdict', 'checkedAt']);
      allow update, delete: if false;
    }
  }
}

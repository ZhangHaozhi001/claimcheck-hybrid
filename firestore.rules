rules_version = '2';
// ClaimCheck Hybrid — least-privilege rules for the judging window.
//
//  - The `checks` history collection is the ONLY accessible path:
//    world-readable (judges verify the archive without an account),
//    create-only with the three fields the app always writes, and
//    immutable afterwards (no update / delete).
//  - Everything else in the database is denied by the catch-all.
//
// App Check layer: the production client initialises App Check
// (debug token for judging, reCAPTCHA Enterprise in production)
// before any Firestore call, so all legitimate client traffic carries
// an App Check token. To hard-require it server-side, enable
// "Enforce App Check" for Cloud Firestore in the Firebase console
// (App Check → APIs) — that toggle is the enforcement point; rules
// stay portable and compile-safe.
// TODO-HOOKUP (post-hackathon): scope per authenticated user, e.g.
// match /checks/{id} { allow read, write: if request.auth != null &&
// request.auth.uid == resource.data.ownerUid; } and add ownerUid on save.
service cloud.firestore {
  match /databases/{database}/documents {
    match /checks/{checkId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['claim', 'verdict', 'checkedAt']);
      allow update, delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
